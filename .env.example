# Copy this file to .env and fill in real values before deploying.

# Port the server listens on
PORT=3000

# Token required in the "x-admin-token" header for any write (POST/PUT/DELETE)
# to /api/*, and for reading /api/leads. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me

# Where the SQLite file lives. Defaults to ./data/tip.db if unset.
# On most PaaS providers, point this at a persistent volume/disk mount
# (e.g. Render Disks, Railway Volumes) so data survives redeploys.
DB_PATH=./data/tip.db

# Comma-free single origin, or leave unset to allow all origins (fine for a
# single-domain deployment where the API and site share one host).
CORS_ORIGIN=
